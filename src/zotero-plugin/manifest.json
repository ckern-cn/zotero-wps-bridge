{
  "manifest_version": 2,
  "name": "Zotero WPS Bridge",
  "version": "0.2.3",
  "description": "Use Zotero citations and bibliographies in WPS Writer",
  "icons": {
    "48": "content/wps.svg",
    "96": "content/wps.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-wps@wps-zotero",
